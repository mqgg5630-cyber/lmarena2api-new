# ========= lmarena2api 配置示例 =========
# 复制本文件为 deploy/.env 后填写真实值（deploy/.env 已被 .gitignore 忽略，不会提交）
# 格式：KEY=VALUE，值不要加引号，# 开头为注释

# --- 必填 ---
# lmarena 站点 cookie 里的 arena-auth-prod-v1 的值（多个用英文逗号分隔）
LA_COOKIE=
# lmarena 站点 cookie 里的 cf_clearance 的值
CF_CLEARANCE=

# --- 强烈建议填 ---
# 必须与你取 cookie 时那个浏览器的 User-Agent 完全一致，否则 Cloudflare 校验会失败。
# 获取方法：浏览器 F12 -> Console -> 输入 navigator.userAgent 回车
# 程序默认值是 Mac 的 UA，Windows 上取的 cookie 必须改成 Windows 的 UA。
USER_AGENT=

# 接口密钥，相当于 OpenAI 的 API-KEY（多个用英文逗号分隔）
API_SECRET=123456

# --- 可选 ---
PORT=10088
DEBUG=true
# 每分钟单 IP 请求上限
REQUEST_RATE_LIMIT=60
# 代理，例如 http://127.0.0.1:10801 或 http://127.0.0.1:7890
# PROXY_URL=
# 路由前缀，设置后接口变成 /hf/v1/chat/completions
# ROUTE_PREFIX=

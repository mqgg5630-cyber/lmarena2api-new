# ========= lmarena2api 配置示例 =========
# 复制本文件为 deploy/.env 后填写真实值（deploy/.env 已被 .gitignore 忽略，不会提交）
#
# 填写规则（重要）：
#   1. 格式为 KEY=值，等号两边不要加空格
#   2. 值【不要】加引号，【不要】带 cookie 名和分号
#      正确： CF_CLEARANCE=abc123.xyz-1747743176-1.2.1.1-QC67...
#      错误： CF_CLEARANCE="cf_clearance=abc123...;"
#   3. 每个值必须写在一行内，不能换行（cookie 很长，注意编辑器不要自动折行成多行）


# --- 必填 1：LA_COOKIE ---
# 来源：浏览器 cookie 中名为 arena-auth-prod-v1 的【值】
# 特征：通常以 base64- 开头，非常长（几百到上千字符）
# 只填等号后面的部分，不要带 "arena-auth-prod-v1=" 前缀
# 多账号可用英文逗号分隔：LA_COOKIE=base64-xxx,base64-yyy
LA_COOKIE=

# --- 可选：CF_CLEARANCE ---
# 来源：浏览器 cookie 中名为 cf_clearance 的【值】
# 特征：形如 <随机串>-1747743176-1.2.1.1-<很长的随机串>，中间有 Unix 时间戳
#
# 【多数情况下没有这个 cookie，留空即可】
# cf_clearance 只有在你真的遇到并通过了 Cloudflare 人机验证挑战后才会签发。
# 如果 Cookie 表格里只看到 __cf_bm，那是另一种 CF cookie，不能代替，留空就行。
# 留空时程序不会携带该字段；若之后请求被 Cloudflare 拦截，再回来补上。
CF_CLEARANCE=

# --- 必填 2：USER_AGENT ---
# 必须与你抓 cookie 时那个浏览器的 UA 完全一致，否则 Cloudflare 校验必失败。
# 获取：浏览器 F12 -> Console -> 输入 navigator.userAgent 回车，去掉两端引号后粘贴
# Windows Chrome 示例（仅供参考，请用你自己的真实值）：
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Safari/537.36
USER_AGENT=

# --- 建议填 ---
# 接口密钥，相当于 OpenAI 的 API-KEY，由你自己随便设定（多个用英文逗号分隔）
API_SECRET=123456

# --- 可选 ---
# 【本服务自己】监听的端口。注意：不要填成代理软件的端口(如 7890)，
# 否则请求会被代理软件接走，表现为 400 错误。保持 10088 即可。
PORT=10088
DEBUG=true
# 每分钟单 IP 请求上限
REQUEST_RATE_LIMIT=60
# 【国内网络必填】代理地址。lmarena.ai 在国内直连不通，不配会报
#   curl: (28) Failed to connect to canary.lmarena.ai:443
# 填你科学上网工具的本地 HTTP 代理端口（在其「设置/端口」里能看到）：
#   Clash / Mihomo 默认 7890、v2rayN 默认 10809、Shadowsocks 默认 1080
# PROXY_URL=http://127.0.0.1:7890

# 站点域名。若官方改版导致连不上，可在此覆盖（默认 canary.lmarena.ai）
# LMARENA_HOST=lmarena.ai
# 路由前缀，设置后接口变成 /hf/v1/chat/completions
# ROUTE_PREFIX=
